rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function hospitalAccountPath() {
      return /databases/$(database)/documents/hospitalAccounts/$(request.auth.uid);
    }

    function approvedHospital() {
      return signedIn()
        && exists(hospitalAccountPath())
        && get(hospitalAccountPath()).data.approved == true;
    }

    function validNewRequest() {
      return request.resource.data.keys().hasAll([
          'requesterUid', 'patientName', 'phone', 'emergencyType', 'location',
          'details', 'status', 'assignedHospitalUid', 'assignedHospitalName',
          'assignedHospitalPhone', 'createdAt', 'updatedAt', 'dispatchedAt',
          'resolvedAt', 'cancelledAt'
        ])
        && request.resource.data.keys().hasOnly([
          'requesterUid', 'patientName', 'phone', 'emergencyType', 'location',
          'details', 'status', 'assignedHospitalUid', 'assignedHospitalName',
          'assignedHospitalPhone', 'createdAt', 'updatedAt', 'dispatchedAt',
          'resolvedAt', 'cancelledAt'
        ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() > 0
        && request.resource.data.patientName.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[0-9+() -]{7,20}$')
        && request.resource.data.emergencyType in [
          'Medical emergency', 'Accident / injury', 'Urgent transport', 'Other urgent help'
        ]
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 300
        && request.resource.data.details is string
        && request.resource.data.details.size() > 0
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'open'
        && request.resource.data.assignedHospitalUid == ''
        && request.resource.data.assignedHospitalName == ''
        && request.resource.data.assignedHospitalPhone == ''
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.dispatchedAt == null
        && request.resource.data.resolvedAt == null
        && request.resource.data.cancelledAt == null;
    }

    match /hospitalAccounts/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list, create, update, delete: if false;
    }

    match /helpRequests/{requestId} {
      allow create: if signedIn() && !approvedHospital() && validNewRequest();

      allow read: if signedIn() && (
        (approvedHospital() && resource.data.status == 'open')
        || (approvedHospital() && resource.data.assignedHospitalUid == request.auth.uid)
        || resource.data.requesterUid == request.auth.uid
      );

      allow update: if signedIn() && (
        (
          approvedHospital()
          && resource.data.status == 'open'
          && request.resource.data.status == 'dispatched'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'assignedHospitalUid', 'assignedHospitalName',
            'assignedHospitalPhone', 'dispatchedAt', 'updatedAt'
          ])
          && request.resource.data.assignedHospitalUid == request.auth.uid
          && get(hospitalAccountPath()).data.name is string
          && get(hospitalAccountPath()).data.name.size() > 0
          && get(hospitalAccountPath()).data.name.size() <= 120
          && request.resource.data.assignedHospitalName == get(hospitalAccountPath()).data.name
          && get(hospitalAccountPath()).data.contactPhone is string
          && get(hospitalAccountPath()).data.contactPhone.matches('^[0-9+() -]{7,20}$')
          && request.resource.data.assignedHospitalPhone == get(hospitalAccountPath()).data.contactPhone
          && request.resource.data.dispatchedAt == request.time
          && request.resource.data.updatedAt == request.time
        )
        || (
          approvedHospital()
          && resource.data.status == 'dispatched'
          && resource.data.assignedHospitalUid == request.auth.uid
          && request.resource.data.status == 'resolved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'resolvedAt', 'updatedAt'
          ])
          && request.resource.data.resolvedAt == request.time
          && request.resource.data.updatedAt == request.time
        )
        || (
          resource.data.requesterUid == request.auth.uid
          && resource.data.status == 'open'
          && request.resource.data.status == 'cancelled'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'status', 'cancelledAt', 'updatedAt'
          ])
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.updatedAt == request.time
        )
      );

      allow delete: if false;
    }
  }
}
